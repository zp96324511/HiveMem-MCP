{
  "name": "hivemem-dsh",
  "version": "0.4.4",
  "description": "Inject the HiveMem project brief into the DSH prompt before each model step, so recall does not depend on the agent remembering to call a tool.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./core": "./lib/core.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "homepage": "https://github.com/zp96324511/HiveMem-MCP/tree/main/dsh-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zp96324511/HiveMem-MCP.git",
    "directory": "dsh-plugin"
  },
  "bugs": {
    "url": "https://github.com/zp96324511/HiveMem-MCP/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "hivemem",
    "memory",
    "context",
    "mcp"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "check": "node --check lib/core.js && node --check lib/index.js && node --test test/core.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
